POWER_PUBLIC_URL=https://coolify.theci.io/power
POWER_SESSION_SECRET=replace-with-at-least-32-random-characters
POWER_SESSION_TTL_SECONDS=900
POWER_LAUNCH_TTL_SECONDS=60
POWER_CONTROL_DRIVER=http
POWER_WTI_BASE_URL=http://192.168.1.150
POWER_WTI_USERNAME=replace-with-wti-web-username
POWER_WTI_PASSWORD=replace-with-wti-web-password
POWER_WTI_HTTP_TIMEOUT_MS=7000
POWER_WTI_TELNET_HOST=192.168.1.150
POWER_WTI_TELNET_PORT=23
POWER_WTI_TELNET_PASSWORD=replace-with-wti-system-password
POWER_WTI_TELNET_TIMEOUT_MS=8000
POWER_WTI_TELNET_ATTEMPTS=3
POWER_SERIAL_DEVICE=/dev/cu.usbserial-FTEPND0D
POWER_SERIAL_PASSWORD=replace-with-serial-console-password
POWER_SERIAL_TIMEOUT_MS=7000
POWER_PROTECTED_OFF_OUTLETS=5
POWER_DB_PATH=/Volumes/miles/Developer/FountainStack/Power/data/power.sqlite
COOLIFY_VALIDATE_URL=https://coolify.theci.io/
POWER_UNIT2_BRIDGE_URL=http://192.168.1.117:3041
