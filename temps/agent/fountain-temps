#!/usr/bin/env python3
"""Read-only, bounded temperature probe. Python 3.11+, standard library only."""
import csv
import datetime as dt
import io
import json
import math
import os
from pathlib import Path
import re
import shutil
import socket
import subprocess
import sys
import time


def read(path):
    try:
        return path.read_text().strip()
    except (OSError, UnicodeError):
        return ""


def number(value):
    try:
        result = float(value)
        return result if math.isfinite(result) else None
    except (TypeError, ValueError):
        return None


def temperature(value, scale=1):
    result = number(value)
    if result is None:
        return None
    result /= scale
    return round(result, 1) if -40 < result < 150 else None


def kind_for(chip):
    for kind, prefixes in (
        ("cpu", ("k10temp", "coretemp", "zenpower")),
        ("gpu", ("amdgpu", "nvidia")), ("nvme", ("nvme",)),
        ("memory", ("spd5118", "jc42")),
        ("board", ("acpitz", "pch_", "nct", "it87")),
        ("network", ("r8169", "iwlwifi", "mt79")),
    ):
        if chip.lower().startswith(prefixes):
            return kind
    return "other"


def reading(kind, chip, device, label, value, max_c=None, crit=None):
    return dict(kind=kind, chip=chip, device=device, label=label,
                celsius=value, max=max_c, crit=crit)


def linux_readings(root=Path("/sys")):
    result = []
    for hwmon in sorted((root / "class/hwmon").glob("hwmon*")):
        chip = read(hwmon / "name") or "unknown"
        # The full physical device path retains PCI/NVMe identity, never hwmonN.
        device_path = (hwmon / "device").resolve() if (hwmon / "device").exists() else hwmon.resolve().parent
        device = str(device_path).removeprefix(str(root / "devices") + "/")
        for sensor in sorted(hwmon.glob("temp*_input")):
            stem = sensor.name.removesuffix("_input")
            label = read(hwmon / (stem + "_label"))
            value = temperature(read(sensor), 1000)
            if value is None or (value == 0 and not label):
                continue
            result.append(reading(kind_for(chip), chip, device, label or stem, value,
                                  temperature(read(hwmon / (stem + "_max")), 1000),
                                  temperature(read(hwmon / (stem + "_crit")), 1000)))
    if not result:
        for zone in sorted((root / "class/thermal").glob("thermal_zone*")):
            chip = read(zone / "type") or "unknown"
            value = temperature(read(zone / "temp"), 1000)
            if value is not None and value != 0:
                result.append(reading(kind_for(chip), chip, zone.name, chip, value))
    return result


def parse_nvidia(text):
    result, warnings = [], []
    for row in csv.reader(io.StringIO(text), skipinitialspace=True):
        if len(row) != 7 or not row[0].strip().isdigit():
            if any(cell.strip() for cell in row):
                warnings.append("nvidia-smi returned an unsupported or failed response")
            continue
        index, name, pci, gpu, memory, _power, _fan = [cell.strip() for cell in row]
        for label, raw in (("GPU", gpu), ("Memory", memory)):
            value = temperature(raw)
            if value is not None:
                result.append(reading("gpu", "nvidia", pci, f"{name} #{index} {label}", value))
        if temperature(gpu) is None or temperature(memory) is None:
            warnings.append(f"nvidia-smi: GPU {index} temperature field unavailable")
    return result, warnings


def parse_macmon(text):
    # macmon pipe streams newline-delimited objects; use the first complete one.
    for line in text.splitlines():
        try:
            data = json.loads(line)
        except (ValueError, TypeError):
            continue
        if not isinstance(data, dict) or not isinstance(data.get("temp"), dict):
            continue
        result = []
        for kind in ("cpu", "gpu"):
            value = temperature(data["temp"].get(f"{kind}_temp_avg"))
            if value is not None:
                result.append(reading(kind, "apple-silicon", "soc", f"{kind.upper()} average", value))
        return result
    return []


def mac_readings():
    executable = shutil.which("macmon")
    if not executable:
        executable = next((path for path in ("/opt/homebrew/bin/macmon", "/usr/local/bin/macmon") if Path(path).is_file()), None)
    if not executable:
        return [], ["macmon not installed"]
    try:
        completed = subprocess.run([executable, "pipe", "-s", "1"], capture_output=True, timeout=2, check=False)
        output = completed.stdout
    except subprocess.TimeoutExpired as exc:
        # A streaming process is expected to remain alive after its first sample.
        output = exc.stdout or b""
    except OSError:
        return [], ["macmon could not run"]
    result = parse_macmon(output.decode("utf-8", errors="replace"))
    return result, [] if result else ["macmon returned no temperature readings"]


def virtualized(root=Path("/sys")):
    identity = " ".join(read(root / "class/dmi/id" / key) for key in ("sys_vendor", "product_name", "board_vendor"))
    return bool(re.search(r"qemu|kvm|vmware|virtualbox|virtual machine|parallels|bochs|bhyve|xen", identity, re.I)
                or (root / "hypervisor/type").exists())


def collect():
    warnings = []
    uptime = None
    if sys.platform == "darwin":
        readings, warnings = mac_readings()
        try:
            boot = subprocess.run(["sysctl", "-n", "kern.boottime"], capture_output=True, text=True, timeout=0.5, check=False)
            match = re.search(r"sec = (\d+)", boot.stdout)
            if match:
                uptime = int(time.time() - int(match[1]))
        except (OSError, subprocess.TimeoutExpired):
            warnings.append("uptime unavailable")
        vm = False
    else:
        readings = linux_readings()
        raw_uptime = read(Path("/proc/uptime")).split()
        uptime = int(float(raw_uptime[0])) if raw_uptime else None
        vm = virtualized()
        nvidia = shutil.which("nvidia-smi")
        if nvidia:
            try:
                response = subprocess.run([nvidia, "--query-gpu=index,name,pci.bus_id,temperature.gpu,temperature.memory,power.draw,fan.speed",
                                           "--format=csv,noheader,nounits"], capture_output=True, text=True, timeout=2, check=False)
                gpu, gpu_warnings = parse_nvidia(response.stdout) if response.returncode == 0 else ([], ["nvidia-smi driver query failed"])
                readings.extend(gpu)
                warnings.extend(gpu_warnings)
            except (OSError, subprocess.TimeoutExpired):
                warnings.append("nvidia-smi unavailable or timed out")
    try:
        load = round(os.getloadavg()[0], 2)
    except OSError:
        load = None
    return dict(schema=1, hostname=socket.gethostname(),
                collected_at=dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z"),
                virtualized=vm, readings=readings, warnings=warnings, uptime_s=uptime, load1=load)


if __name__ == "__main__":
    # Deliberately ignore arguments and SSH_ORIGINAL_COMMAND: no command execution surface.
    try:
        payload = collect()
    except Exception:
        payload = dict(schema=1, hostname=socket.gethostname(), collected_at=dt.datetime.now(dt.timezone.utc).isoformat(),
                       virtualized=False, readings=[], warnings=["temperature probe failed"], uptime_s=None, load1=None)
    print(json.dumps(payload, allow_nan=False, separators=(",", ":")))
